# Copia a .env (que NO se sube a Git). Valores de ejemplo solo para desarrollo.
POSTGRES_PASSWORD=cambia-esto-en-local
DATABASE_URL=postgres://uniapp:cambia-esto-en-local@localhost:5432/uniapp?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TUTOR_EMAIL_DOMAIN=uni.edu.pe
# Cuentas sintéticas de prueba (nunca en producción)
SEED_SYNTHETIC=true
SEED_PASSWORD=Dev-Passw0rd!2026
# SMTP opcional; sin SMTP_HOST el correo se escribe en el log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@uniapp.test
