# Estructura de .env para desarrollo local
POSTGRES_PASSWORD=cambia-esto-en-local
DATABASE_URL=postgres://uniapp:cambia-esto-en-local@localhost:5432/uniapp?sslmode=disable
# APP_ENV=prod exige FRONTEND_ORIGIN pública: los enlaces de recuperación
# viajan por correo y deben abrirse desde el navegador del usuario.
APP_ENV=dev
# Uno o varios orígenes permitidos, separados por coma. El PRIMERO es el que va
# en los enlaces de correo (confirmación, recuperación) y la comprobación de
# Origin acepta cualquiera de la lista (útil para localhost + IP del VPS).
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TUTOR_EMAIL_DOMAIN=uni.edu.pe,uni.pe
# Cuentas sintéticas de prueba 
SEED_SYNTHETIC=true
SEED_PASSWORD=Dev-Passw0rd!2026
# Directorio privado para documentos de expedientes (nunca se sirve como estático).
TUTOR_DOCUMENTS_DIR=./data/tutor-documents
# SMTP opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Alternativa sin exponer la clave como variable: leerla de un archivo. Con
# Docker secrets se monta en /run/secrets/<nombre> (ver docs/despliegue-vps.md).
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=no-responder@uniapp.test
